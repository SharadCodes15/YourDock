{
  "pinned": [
    "finder",
    "launchpad",
    "safari",
    "mail",
    "appstore",
    "preferences"
  ],
  "autoHide": true,
  "apps": {
    "finder": {
      "name": "Finder",
      "win": "explorer.exe",
      "mac": "/System/Library/CoreServices/Finder.app",
      "process": "explorer.exe"
    },
    "launchpad": {
      "name": "Launchpad",
      "win": "explorer.exe shell:AppsFolder",
      "mac": "/System/Applications/Launchpad.app",
      "process": "explorer.exe"
    },
    "safari": {
      "name": "Safari",
      "win": "msedge",
      "mac": "/System/Volumes/Preboot/Cryptexes/App/System/Applications/Safari.app",
      "process": "msedge.exe"
    },
    "mail": {
      "name": "Mail",
      "win": "mailto:",
      "mac": "/System/Applications/Mail.app",
      "process": "outlook.exe"
    },
    "appstore": {
      "name": "App Store",
      "win": "ms-windows-store:",
      "mac": "/System/Applications/App Store.app",
      "process": "winstore.app.exe"
    },
    "preferences": {
      "name": "System Preferences",
      "win": "ms-settings:",
      "mac": "/System/Applications/System Settings.app",
      "process": "systemsettings.exe"
    },
    "trash": {
      "name": "Trash",
      "win": "explorer.exe shell:RecycleBinFolder",
      "mac": "",
      "process": "explorer.exe"
    }
  }
}