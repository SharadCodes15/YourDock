{
  "name": "macos-top-menu-bar",
  "version": "1.0.0",
  "description": "macOS Big Sur-style Top Menu Bar in Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:portable": "electron-builder -w portable"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "active-win": "^8.0.2",
    "loudness": "^0.4.2",
    "systeminformation": "^5.31.17"
  },
  "devDependencies": {
    "electron": "^31.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.sharadcodes.macdock",
    "productName": "macOS Dock and Menu Bar",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "macOS Dock & Menu Bar"
    },
    "files": [
      "main.js",
      "focusForwarder.js",
      "appscanner.js",
      "configPaths.js",
      "index.html",
      "about.html",
      "forcequit.html",
      "settings.html",
      "controlcenter.html",
      "spotlight.html",
      "preload.js",
      "settings-preload.js",
      "spotlight-preload.js",
      "controlcenter-preload.js",
      "closeOnEscape.js",
      "startupVisibility.js",
      "welcome.html",
      "dock/drawer-preload.js",
      "dock/drawer.html",
      "dock/preload.js",
      "dock/index.html",
      "dock/main.js",
      "!dock/icons-cache/**/*",
      "!tests/**/*",
      "!logs/**/*"
    ],
    "extraResources": [
      "devToolsBlacklist.json",
      "settings.json",
      "dock/apps.json",
      "dock/config.json"
    ]
  },
  "author": "",
  "license": "ISC"
}
